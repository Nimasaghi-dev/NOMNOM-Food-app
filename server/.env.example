# Port the Express server listens on
PORT=3000

# PostgreSQL connection string used by Prisma.
# Local default matches docker-compose.yml. For production, use your hosted
# Postgres URL (e.g. Neon/Railway/Render).
DATABASE_URL=postgresql://nomnom:nomnom@localhost:5433/nomnom?schema=public

# Secret key used to sign and verify JWT tokens — use a long random string (32+ characters)
TOKEN_KEY=replace_this_with_a_long_random_secret

# Secret used for Express session (needed for OAuth flows)
SESSION_SECRET=replace_this_with_another_long_random_secret

# Google OAuth credentials (only needed if you want Google login)
# Get these from https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend URL — used by CORS to allow requests from the React dev server
CLIENT_URL=http://localhost:8080

# Set to "production" when deploying to a host
NODE_ENV=development
